# LocalDevOS Environment Configuration

# Gemini API Key (Required for Gemini 3.5 Flash cloud escalation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Ollama Models (Local & Cloud)
OLLAMA_LOCAL_MODEL=llama3.2
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

# Model Routing Mode (auto | llama | gemini | gpt-oss | local)
MODEL_ROUTING=auto

# Maximum agent iteration loops per task execution
MAX_AGENT_ITERATIONS=8

# Bounded retry count for local model before escalation
MAX_LOCAL_ATTEMPTS=2
