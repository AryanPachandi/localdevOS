# LocalDevOS Environment Configuration

# Gemini API Key (Required for Gemini 3.5 Flash cloud escalation)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model ID (Default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Model Routing Mode (auto | local | gemini)
MODEL_ROUTING=auto

# Bounded retry count for local model before escalation
MAX_LOCAL_ATTEMPTS=2
